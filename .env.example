# The OLLAMA_* names are historical - the project started on a local Ollama server and moved to
# the OpenAI API. app/llm/client.py speaks the OpenAI protocol and reads these three variables.

# OpenAI (default)
OLLAMA_BASE_URL=https://api.openai.com
OLLAMA_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your-key-here

# To run against a local Ollama server instead:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:1.7b
# OPENAI_API_KEY=dummy

OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
